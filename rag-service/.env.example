
# Doivent etre IDENTIQUES a ingestion-service/.env (contrat d'index partage)
DATA_SOURCE=confluence
VECTOR_STORE=azure_search
AZURE_SEARCH_ENDPOINT=https://xxx.search.windows.net
AZURE_SEARCH_API_KEY=

SEARCH_MODE=hybrid

LLM_SERVICE=azure_openai
AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

INGESTION_SERVICE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000

# Uniquement si VECTOR_STORE=chromadb : meme valeur que dans ingestion-service/.env
# CHROMA_DIR=
